# Copy to .env and fill in. Never commit .env.

# --- LLM provider: azure, openai, or fake --------------------------------------
# fake = local stand-in models: no key, no cost (tests, demos, load tests).
LLM_PROVIDER=azure

# --- Azure OpenAI (when LLM_PROVIDER=azure) -----------------------------------
# Endpoint and key: Azure portal > your Azure OpenAI resource > Keys and Endpoint.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment NAMES from Azure AI Foundry > Deployments (not model names).
AZURE_EMBEDDING_DEPLOYMENT=
AZURE_VISION_DEPLOYMENT=
AZURE_CHAT_DEPLOYMENT=
AZURE_FAST_DEPLOYMENT=

# --- Cost guard ----------------------------------------------------------------
# Hard caps per ingest run; the run stops before a call that would exceed them.
MAX_EMBED_TOKENS_PER_RUN=200000
MAX_OCR_PAGES_PER_RUN=10
MAX_CHAT_CALLS_PER_RUN=200
# API and workers use DAILY caps shared through Redis (set automatically):
MAX_EMBED_TOKENS_PER_DAY=250000000
MAX_OCR_PAGES_PER_DAY=20000
MAX_CHAT_CALLS_PER_DAY=50000
# Shared per-minute limits across all workers (Docker sets RATE_LIMIT_ENABLED=true).
# Keep them below your Azure deployment quotas.
RATE_LIMIT_ENABLED=false
EMBED_TPM_LIMIT=800000
VISION_RPM_LIMIT=300
CHAT_RPM_LIMIT=2000        # chat + fast deployments together
CHAT_TPM_LIMIT=2000000
CHAT_RATE_WAIT_S=20        # then answer 503 + Retry-After
# Your prices, used only for estimates in --dry-run and run summaries.
EMBED_PRICE_PER_1M_TOKENS=0.02
OCR_PRICE_PER_PAGE=0.003

# --- OpenAI direct (when LLM_PROVIDER=openai) ------------------------------------
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
# Model names: use the ones your OpenAI account has access to.
CHAT_MODEL=gpt-5
FAST_MODEL=gpt-5-mini
VISION_MODEL=gpt-5-mini
# Your account's embedding tokens-per-minute limit (platform.openai.com > Limits).
OPENAI_EMBED_TPM_LIMIT=1000000

# --- Services ----------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=docs
POSTGRES_DSN=postgresql+psycopg://rag:rag@127.0.0.1:5432/rag
REDIS_URL=redis://127.0.0.1:6379/0

# Raw file storage: "local" (folder), "azure" (Blob Storage) or "s3".
BLOB_BACKEND=local
BLOB_ROOT=data/blobs
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_BLOB_CONTAINER=rag-raw
# S3_BUCKET=
# S3_ENDPOINT_URL=

# --- Capacity targets (used by scripts/capacity.py) --------------------------
DOCS_PER_DAY=10000
PEAK_FACTOR=5
AVG_PAGES_PER_DOC=15
SCANNED_PAGE_RATIO=0.10

# --- Question answering ---------------------------------------------------------
RETRIEVE_K=40              # hybrid search candidates
RERANK_ENABLED=true        # local cross-encoder (free, CPU)
RERANK_CANDIDATES=20
RERANK_TOP_N=6             # sources given to the answer model
MAX_QUERY_RETRIES=2        # rewrite-and-search-again attempts before "not found"
GROUNDING_CHECK=true       # extra fast-model call that checks the answer against sources
GROUNDING_SAMPLE_RATE=1.0  # check only this fraction of answers (saves calls at scale)
SOURCE_MAX_CHARS=1500      # per source sent to the LLM: the main token cost per question
ANSWER_CACHE_ENABLED=true  # repeated first questions served from Redis
ANSWER_CACHE_TTL_S=3600
# RERANK_URL=http://rerank:8001   # remote rerank service (GPU); unset = rerank in-process
PDF_PARSER=docling         # or fast: ~7x cheaper per page, loses headings/tables

# --- API and workers ----------------------------------------------------------------
AUTH_MODE=none             # production: keys (create with scripts/api_keys.py)
# API_KEY=                 # optional bootstrap admin key
INGEST_MODE=inline         # inline: API processes uploads itself (dev); queue: Celery workers
MAX_UPLOAD_MB=100
INGEST_MAX_RETRIES=3
CHECKPOINT_DURABILITY=exit # save conversation once per question (fastest)
IO_THREADS=64
LOG_JSON=false             # true in production (structured logs)

# --- PII and secrets --------------------------------------------------------------
PII_ENGINE=regex            # regex (fast, local) | presidio (adds name detection; pip install -e .[pii])
PII_INGEST_POLICY=tag       # off | tag (mark chunks) | redact (<EMAIL> placeholders) | block (reject file)
PII_QUERY_POLICY=storage    # off | storage (mask saved conversations) | llm (also mask before search/LLM)
SECRET_REDACTION=true       # API keys, passwords, private keys removed from documents and answers
OUTPUT_REDACT_PII=false     # also mask PII in answers

# --- Guardrails ------------------------------------------------------------------------
GUARD_INPUT_POLICY=block    # off | flag | block prompt-injection / jailbreak questions
GUARD_DOC_INJECTION=tag     # off | tag | drop document chunks containing hidden instructions
# BLOCKED_TOPICS=salar(y|ies),passwords?     # comma-separated regexes to refuse

# --- Retention and platform security -----------------------------------------------------
CHAT_RETENTION_DAYS=30      # scripts/purge.py deletes older conversations
OCR_CACHE_ENABLED=true      # false for sensitive corpora (no transcribed text on disk)
MAX_PDF_PAGES=2000
AUTH_FAIL_LIMIT_PER_MIN=20  # failed API-key attempts per IP before 429
# CORS_ORIGINS=https://app.example.com
HSTS=false                  # true behind HTTPS

